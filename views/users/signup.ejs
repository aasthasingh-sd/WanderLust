<%- layout("./layouts/boilerplate") %>
<div class="row mt-3">
    <h1 class="col-6 offset-2">SignUp on WanderLust</h1>
    <div class="col-6 offset-2">
     <form action="/users/signup" method="post" class="needs-validation" novalidate>

    <div class="mb-3">
      <label for="username" class="form-label">Username</label>
      <input placeholder="Enter username" name="username" id="username" class="form-control" required>
      <div class="valid-feedback">Looks good!!</div>
      <div class="invalid-feedback">Enter valid Username</div>
      </div>

      <div class="mb-3">
      <label for="email" class="form-label">Email</label>
      <input placeholder="Enter email" name="email" id="email" class="form-control" required>
      <div class="valid-feedback">Looks good!!</div>
      <div class="invalid-feedback">Enter valid email</div>
      </div>

      <div class="mb-3">
      <label for="password" class="form-label">Password</label>
      <input placeholder="Enter password" name="password" id="password" class="form-control"  type="password" required>
      <div class="valid-feedback">Looks good!!</div>
      <div class="invalid-feedback">Enter valid password</div>
      </div>
     
     <button class="btn btn-success">SignUp</button>
     </form>
    </div>
</div>